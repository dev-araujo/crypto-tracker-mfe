/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@crypto/shared-data-access": ["./libs/shared-data-access/src/public-api.ts"],
      "@crypto/shared-state": ["./libs/shared-state/src/public-api.ts"],
      "@crypto/shared-ui": ["./libs/shared-ui/src/public-api.ts"],
      "@crypto/shared-utils": ["./libs/shared-utils/src/public-api.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./shell/tsconfig.app.json"
    },
    {
      "path": "./shell/tsconfig.spec.json"
    },
    {
      "path": "./remotes/market/tsconfig.app.json"
    },
    {
      "path": "./remotes/market/tsconfig.spec.json"
    },
    {
      "path": "./remotes/analytics/tsconfig.app.json"
    },
    {
      "path": "./remotes/analytics/tsconfig.spec.json"
    },
    {
      "path": "./remotes/watchlist/tsconfig.app.json"
    },
    {
      "path": "./remotes/watchlist/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-ui/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-ui/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-utils/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-utils/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-state/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-state/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-data-access/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-data-access/tsconfig.spec.json"
    }
  ]
}
