COINRANKING_API_KEY=your_api_key_here
# Caminho que o cliente chama; o proxy injeta a credencial
COINRANKING_BASE_URL=/api/coinranking

# Destino real, usado apenas pelo proxy (servidor)
COINRANKING_UPSTREAM_URL=https://api.coinranking.com/v2

# Intervalo de revalidação automática dos dados, em ms (padrão 120000)
DATA_REVALIDATE_INTERVAL_MS=120000

# URLs públicas dos remotes (usadas ao gerar o federation.manifest.json)
MFE_MARKET_URL=http://localhost:4201
MFE_ANALYTICS_URL=http://localhost:4202
MFE_WATCHLIST_URL=http://localhost:4203
